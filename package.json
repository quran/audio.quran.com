{
	"name": "qaudio",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./jsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./jsconfig.json --watch",
		"test": "node --test",
		"format": "oxfmt -c .oxfmtrc.json .",
		"format:check": "oxfmt --check -c .oxfmtrc.json .",
		"lint": "oxlint -c oxlint.config.js .",
		"lint:fix": "oxlint --fix -c oxlint.config.js ."
	},
	"dependencies": {
		"@sveltejs/adapter-node": "^5.4.0",
		"@sveltejs/kit": "^2.53.3",
		"pg": "^8.16.3"
	},
	"devDependencies": {
		"@lucide/svelte": "^0.561.0",
		"@mustafaj/oxfmt": "0.58.0-svelte.6",
		"@mustafaj/oxlint": "1.73.0-svelte.9",
		"@sveltejs/vite-plugin-svelte": "^6.2.1",
		"@tailwindcss/vite": "^4.1.17",
		"@types/node": "^24",
		"globals": "^16.5.0",
		"svelte": "^5.53.5",
		"svelte-check": "^4.3.4",
		"tailwindcss": "^4.1.17",
		"typescript": "^5.9.3",
		"vite": "^7.2.6",
		"vite-plugin-devtools-json": "^1.0.0",
		"vite-plugin-domain": "^1.1.3"
	}
}
